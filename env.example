# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key — safe to expose to the browser. Not currently used by this
# app (all Supabase access happens server-side), kept here so the project's
# full API key set is documented in one place.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Secret key — server-only, never expose to the browser. Used by all API
# routes/server components to read and write the webinars table.
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Anthropic API key used to generate BDR guidance
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional: override the default Claude model
CLAUDE_MODEL=claude-sonnet-5

# Random secret used to authorize the daily cron request (Vercel sends it as
# `Authorization: Bearer $CRON_SECRET`). Generate with: openssl rand -hex 32
CRON_SECRET=your-cron-secret
